<Window x:Class="Kaching.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kaching Windows for Shopify"
        Width="1240"
        Height="820"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource InkBrush}" Padding="24">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Kaching" Foreground="White" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Shopify Monitor" Foreground="#CBD5E1" FontSize="16" Margin="0,2,0,28" />
                    <TextBlock Text="Ventas" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <TextBlock Text="Pedidos nuevos" Foreground="#CBD5E1" Margin="0,0,0,12" />
                    <TextBlock Text="Historial" Foreground="#CBD5E1" Margin="0,0,0,12" />
                    <TextBlock Text="Notificaciones" Foreground="#CBD5E1" Margin="0,0,0,12" />
                    <TextBlock Text="Inicio Windows" Foreground="#CBD5E1" Margin="0,0,0,12" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="Estado" Foreground="#94A3B8" FontSize="12" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32">
                <DockPanel Margin="0,0,0,24">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Monitor de ventas Shopify" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="Detecta pedidos pagados, reproduce kaching.wav y notifica desde Windows" Foreground="{StaticResource MutedInkBrush}" FontSize="14" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Revisar ahora" Command="{Binding CheckNowCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                        <Button Content="Iniciar monitor" Command="{Binding StartMonitoringCommand}" Margin="0,0,10,0" />
                        <Button Content="Detener" Command="{Binding StopMonitoringCommand}" Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                </DockPanel>

                <UniformGrid Columns="4" Margin="0,0,0,8">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Ventas del dia" Foreground="{StaticResource MutedInkBrush}" />
                            <TextBlock Text="{Binding Snapshot.OrdersToday}" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Total hoy" Foreground="{StaticResource MutedInkBrush}" />
                            <TextBlock Text="{Binding Snapshot.SalesToday, Converter={StaticResource CurrencyConverter}}" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Total vendido" Foreground="{StaticResource MutedInkBrush}" />
                            <TextBlock Text="{Binding Snapshot.TotalSold, Converter={StaticResource CurrencyConverter}}" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Moneda" Foreground="{StaticResource MutedInkBrush}" />
                            <TextBlock Text="{Binding Snapshot.CurrencyCode}" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.95*" />
                        <ColumnDefinition Width="1.05*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Configuracion Shopify" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                            <TextBlock Text="Tienda" Foreground="{StaticResource MutedInkBrush}" />
                            <TextBox Text="{Binding ShopDomain, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" Margin="0,6,0,14" Padding="8" />
                            <TextBlock Text="Admin API token" Foreground="{StaticResource MutedInkBrush}" />
                            <TextBox Text="{Binding AccessToken, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" Margin="0,6,0,14" Padding="8" />
                            <TextBlock Text="Intervalo de revision (segundos)" Foreground="{StaticResource MutedInkBrush}" />
                            <TextBox Text="{Binding PollIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" Margin="0,6,0,14" Padding="8" />
                            <CheckBox IsChecked="{Binding AutoStartWithWindows}" Content="Iniciar automaticamente con Windows" Margin="0,0,0,18" />
                            <Button Content="Guardar configuracion" Command="{Binding SaveSettingsCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Ultima venta" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                            <TextBlock Text="{Binding Snapshot.LatestOrder.Name, TargetNullValue=Sin ventas registradas}" FontSize="32" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Snapshot.LatestOrder.DisplayCustomer}" Foreground="{StaticResource MutedInkBrush}" FontSize="15" Margin="0,6,0,16" />
                            <TextBlock Text="{Binding Snapshot.LatestOrder.TotalAmount, Converter={StaticResource CurrencyConverter}}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="{Binding Snapshot.LatestOrder.CreatedAt, StringFormat=Pedido recibido {0:g}}" Foreground="{StaticResource MutedInkBrush}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Historial de ventas" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Pedido" Foreground="{StaticResource MutedInkBrush}" />
                            <TextBlock Grid.Column="1" Text="Cliente" Foreground="{StaticResource MutedInkBrush}" />
                            <TextBlock Grid.Column="2" Text="Fecha" Foreground="{StaticResource MutedInkBrush}" />
                            <TextBlock Grid.Column="3" Text="Estado" Foreground="{StaticResource MutedInkBrush}" />
                            <TextBlock Grid.Column="4" Text="Total" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding SalesHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayCustomer}" />
                                        <TextBlock Grid.Column="2" Text="{Binding CreatedAt, StringFormat={}{0:g}}" Foreground="{StaticResource MutedInkBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding FinancialStatus}" Foreground="{StaticResource MutedInkBrush}" />
                                        <TextBlock Grid.Column="4" Text="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

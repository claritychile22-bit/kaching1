<Window x:Class="Kaching.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kaching Windows"
        Width="1240"
        Height="820"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource InkBrush}" Padding="24">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Kaching" Foreground="White" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Windows" Foreground="#CBD5E1" FontSize="16" Margin="0,2,0,28" />
                    <TextBlock Text="Panel" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <TextBlock Text="Cuentas" Foreground="#CBD5E1" Margin="0,0,0,12" />
                    <TextBlock Text="Presupuestos" Foreground="#CBD5E1" Margin="0,0,0,12" />
                    <TextBlock Text="Movimientos" Foreground="#CBD5E1" Margin="0,0,0,12" />
                    <TextBlock Text="Reportes" Foreground="#CBD5E1" Margin="0,0,0,12" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="Estado" Foreground="#94A3B8" FontSize="12" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32">
                <DockPanel Margin="0,0,0,24">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Resumen financiero" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="Vista ejecutiva de caja, gastos y presupuesto mensual" Foreground="{StaticResource MutedInkBrush}" FontSize="14" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Actualizar" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                        <Button Content="Venta rapida" Command="{Binding AddSaleCommand}" Margin="0,0,10,0" />
                        <Button Content="Reiniciar demo" Command="{Binding ResetDemoCommand}" Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                </DockPanel>

                <UniformGrid Columns="4" Margin="0,0,0,8">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Patrimonio" Foreground="{StaticResource MutedInkBrush}" />
                            <TextBlock Text="{Binding Snapshot.NetWorth, Converter={StaticResource CurrencyConverter}}" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Ingresos mes" Foreground="{StaticResource MutedInkBrush}" />
                            <TextBlock Text="{Binding Snapshot.MonthlyIncome, Converter={StaticResource CurrencyConverter}}" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Gastos mes" Foreground="{StaticResource MutedInkBrush}" />
                            <TextBlock Text="{Binding Snapshot.MonthlyExpenses, Converter={StaticResource CurrencyConverter}}" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Tasa ahorro" Foreground="{StaticResource MutedInkBrush}" />
                            <TextBlock Text="{Binding Snapshot.SavingsRate, Converter={StaticResource PercentConverter}}" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Presupuesto mensual" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                            <ItemsControl ItemsSource="{Binding CategorySpending}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,16">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Category}" FontWeight="SemiBold" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Spent, Converter={StaticResource CurrencyConverter}}" Foreground="{StaticResource MutedInkBrush}" />
                                            </DockPanel>
                                            <ProgressBar Value="{Binding Usage}" Maximum="1" Height="8" Margin="0,8,0,4" Foreground="{Binding AccentColor}" Background="#EEF2F7" />
                                            <TextBlock Text="{Binding Remaining, Converter={StaticResource CurrencyConverter}, StringFormat=Disponible {0}}" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Cuentas" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                            <ItemsControl ItemsSource="{Binding Accounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                                            <DockPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Institution}" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                                </StackPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding OpeningBalance, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Actividad reciente" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                        <ItemsControl ItemsSource="{Binding RecentTransactions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Date}" Foreground="{StaticResource MutedInkBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Description}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Category}" Foreground="{StaticResource MutedInkBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding SignedAmount, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
